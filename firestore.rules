rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == role)
      );
    }

    function isOfficer() {
      return hasRole('command_center') ||
             hasRole('project_admin') ||
             hasRole('district_officer') ||
             hasRole('field_officer');
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Users / RBAC Profiles ─────────────────────────────────────
    match /users/{userId} {
      allow read: if isSelf(userId) || isOfficer();
      allow create, update: if isSelf(userId) || hasRole('command_center');
      allow delete: if hasRole('command_center');
    }

    // ── Citizen Cases ─────────────────────────────────────────────
    match /citizenCases/{caseId} {
      allow read: if isAuthenticated();
      allow write: if isOfficer();
    }

    // ── Parcels (Cadastral & Spatial Map) ──────────────────────────
    match /parcels/{parcelId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // ── Field Parcels (Ground Verification & Geotags) ─────────────
    match /fieldParcels/{parcelId} {
      allow read: if isAuthenticated();
      allow update: if hasRole('field_officer') || isOfficer();
      allow create, delete: if isOfficer();
    }

    // ── Projects ──────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if true;
      allow write: if hasRole('command_center') || hasRole('project_admin');
    }

    // ── National Stats & State Overviews ──────────────────────────
    match /nationalStats/{docId} {
      allow read: if true;
      allow write: if hasRole('command_center');
    }

    match /states/{stateId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // ── District Cases, Critical Alerts & Risk Registry ───────────
    match /districtCases/{caseId} {
      allow read: if isAuthenticated();
      allow write: if isOfficer();
    }

    match /criticalAlerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isOfficer();
    }

    match /riskItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isOfficer();
    }

    // ── Digital Document Vault & Upload Metadata ──────────────────
    match /uploadedDocuments/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOfficer();
    }
  }
}
